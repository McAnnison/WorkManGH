# Backend API
PORT=3000

# PostgreSQL connection string used by Prisma and the pg adapter.
# Replace with your own local or hosted database credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long, random secret. Never commit a real value.
JWT_SECRET="replace-with-a-long-random-secret"

# Expo client-side API URL. Use your computer's LAN IP for a physical Android device.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
